# ==========================================
# RAILPULSE ENVIRONMENT CONFIGURATION
# Smart India Hackathon 2026 - SIH26028
# ==========================================

# Railway Live Data (RailRadar API)
RAILRADAR_API_KEY=
RAILRADAR_BASE_URL=https://api.railradar.in/v1

# Weather (OpenWeather / Open-Meteo)
OPENWEATHER_API_KEY=

# PostgreSQL Database (Optional - defaults to SQLite)
DATABASE_URL=

# JWT Secret for Controller Authentication
JWT_SECRET=railpulse_sih2026_super_secure_jwt_secret_key_change_in_production

# Application & Environment
ENVIRONMENT=development
LIVE_UPDATE_INTERVAL_SECONDS=60

# Frontend CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
